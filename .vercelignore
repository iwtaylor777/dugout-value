# Paths are anchored to the repo root with a leading slash. Unanchored names match at any depth in Vercel's
# Git builds, and a bare "analysis" once removed app/analysis (the route) and public/analysis (figures).
/node_modules
/.next
/.vinext
/.wrangler
/.git

/analysis
/coverage
/docs
/outputs
/work

/.env*
*.log

# Local-only folders that the site never reads
/Red Sox
/tmp
/output
/dist
/data/refresh-archives
